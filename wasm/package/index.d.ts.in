export type Move = `${"a" | "b" | "c" | "d" | "e" | "f" | "g"}${
  | 1
  | 2
  | 3
  | 4
  | 5
  | 6
  | 7}`;

export interface AnalysisRequest {
  readonly moves: readonly Move[];
  readonly searchTimeMs: number;
  readonly maxDepth?: number;
  readonly multiPv?: 1 | 2 | 3 | 4 | 5;
}

export interface AnalysisLine {
  readonly rank: number;
  readonly move: Move;
  readonly equivalentMoves: readonly Move[];
  /** Signed evaluation in half-points; positive favors Player 1. */
  readonly evaluationHalfPoints: number;
  /** A legal prefix beginning with `move`. */
  readonly principalVariation: readonly Move[];
}

export interface AnalysisSuccess {
  readonly ok: true;
  readonly bestMove: Move;
  /** Signed evaluation in half-points; positive favors Player 1. */
  readonly evaluationHalfPoints: number;
  readonly principalVariation: readonly Move[];
  readonly lines: readonly AnalysisLine[];
  readonly completedDepth: number;
  readonly nodes: number;
  readonly engineVersion: "@PROJECT_VERSION@";
  readonly apiVersion: 1;
}

export type AnalysisErrorCode =
  | "invalid_request"
  | "invalid_history"
  | "malformed_history_move"
  | "illegal_history_move"
  | "invalid_search_time"
  | "invalid_max_depth"
  | "invalid_multi_pv"
  | "terminal_position"
  | "search_incomplete";

export interface AnalysisError {
  readonly code: AnalysisErrorCode;
  readonly message: string;
  readonly field?: "request" | "moves" | "searchTimeMs" | "maxDepth" | "multiPv";
  /** Zero-based index in `moves`. */
  readonly moveIndex?: number;
  readonly move?: string;
  readonly reason?: "out_of_bounds" | "game_over" | "occupied";
}

export interface AnalysisFailure {
  readonly ok: false;
  readonly error: AnalysisError;
  readonly engineVersion: "@PROJECT_VERSION@";
  readonly apiVersion: 1;
}

export type AnalysisResponse = AnalysisSuccess | AnalysisFailure;

export interface AnalyzeOptions {
  /** Called synchronously after each fully completed common search depth. */
  readonly onProgress?: (update: AnalysisSuccess) => void;
}

export interface Engine {
  /** Synchronous and CPU-bound; call from a Web Worker. */
  analyze(request: AnalysisRequest, options?: AnalyzeOptions): AnalysisResponse;
}

export interface CreateEngineOptions {
  /** Override the packaged WASM URL, for example with a Vite `?url` import. */
  readonly wasmUrl?: string | URL;
}

export default function createEngine(options?: CreateEngineOptions): Promise<Engine>;
